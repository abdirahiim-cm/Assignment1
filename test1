$num1 = 15;
$num2 = 42;
$num3 = 7;

// Finding the largest
if ($num1 >= $num2 && $num1 >= $num3) {
    $largest = $num1;
} elseif ($num2 >= $num1 && $num2 >= $num3) {
    $largest = $num2;
} else {
    $largest = $num3;
}

// Finding the smallest
if ($num1 <= $num2 && $num1 <= $num3) {
    $smallest = $num1;
} elseif ($num2 <= $num1 && $num2 <= $num3) {
    $smallest = $num2;
} else {
    $smallest = $num3;
}

echo "Numbers: $num1, $num2, $num3\n";
echo "Largest: $largest\n";
echo "Smallest: $smallest\n";
